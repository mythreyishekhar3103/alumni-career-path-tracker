import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import plotly.express as px

# -------------------------------
# Load Datasets
# -------------------------------

career_df = pd.read_csv("../data/career_recommendation_dataset.csv")
jobs_df = pd.read_csv("../data/jobss.csv")
job_desc_df = pd.read_csv("../data/job_title_des.csv")
unemployment_df = pd.read_csv("../data/youth_unemployment_global.csv")
resume_df = pd.read_csv("../data/resume_dataset_200k_enhanced.csv")

# -------------------------------
# Dataset Overview
# -------------------------------

datasets = {
    "Career Dataset": career_df,
    "Jobs Dataset": jobs_df,
    "Job Description Dataset": job_desc_df,
    "Unemployment Dataset": unemployment_df,
    "Resume Dataset": resume_df
}

for name, df in datasets.items():

    print("\n" + "=" * 70)
    print(name)
    print("=" * 70)

    print("Shape:", df.shape)
    print("\nColumns:")
    print(df.columns.tolist())

    print("\nMissing Values:")
    print(df.isnull().sum().sum())

    print("\nDuplicate Rows:")
    print(df.duplicated().sum())

# -------------------------------
# Career Dataset Analysis
# -------------------------------

print("\nCareer Dataset Sample")
print(career_df.head())

print("\nCareer Dataset Statistics")
print(career_df.describe())

# -------------------------------
# Missing Values
# -------------------------------

print("\nMissing Values in Career Dataset")
print(
    career_df.isnull()
    .sum()
    .sort_values(ascending=False)
)

# -------------------------------
# Correlation Heatmap
# -------------------------------

numeric_df = career_df.select_dtypes(
    include=["int64", "float64"]
)

if not numeric_df.empty:

    plt.figure(figsize=(12, 8))

    sns.heatmap(
        numeric_df.corr(),
        annot=False
    )

    plt.title("Career Dataset Correlation Heatmap")
    plt.show()

# -------------------------------
# Career Recommendation Analysis
# -------------------------------

target_col = "Primary_Career_Recommendation"

if target_col in career_df.columns:

    plt.figure(figsize=(10, 5))

    career_df[target_col] \
        .value_counts() \
        .head(10) \
        .plot(kind="bar")

    plt.title("Top Career Recommendations")
    plt.show()

# -------------------------------
# Job Dataset Analysis
# -------------------------------

print("\nJobs Dataset Sample")
print(jobs_df.head())

print("\nJobs Dataset Statistics")
print(jobs_df.describe())

# -------------------------------
# Salary Distribution
# -------------------------------

salary_col = "sal"

if salary_col in jobs_df.columns:

    plt.figure(figsize=(10, 5))

    jobs_df[salary_col].hist(
        bins=30
    )

    plt.title("Salary Distribution")
    plt.show()

# -------------------------------
# Location Analysis
# -------------------------------

location_col = "Location"

if location_col in jobs_df.columns:

    plt.figure(figsize=(10, 5))

    jobs_df[location_col] \
        .value_counts() \
        .head(10) \
        .plot(kind="bar")

    plt.title("Top Hiring Locations")
    plt.show()

# -------------------------------
# Interactive Salary Chart
# -------------------------------

if salary_col in jobs_df.columns:

    fig = px.histogram(
        jobs_df,
        x=salary_col,
        title="Salary Distribution"
    )

    fig.show()

# -------------------------------
# Resume Dataset Analysis
# -------------------------------

print("\nResume Dataset Sample")
print(resume_df.head())

print("\nResume Dataset Shape")
print(resume_df.shape)

# -------------------------------
# Unemployment Dataset Analysis
# -------------------------------

print("\nUnemployment Dataset Sample")
print(unemployment_df.head())

print("\nUnemployment Dataset Statistics")
print(unemployment_df.describe())

# -------------------------------
# Save Cleaned Dataset
# -------------------------------

career_cleaned = (
    career_df
    .drop_duplicates()
    .dropna()
)

career_cleaned.to_csv(
    "../data/cleaned_career_dataset.csv",
    index=False
)

print("\nCleaned Career Dataset Saved Successfully!")
